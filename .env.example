# alikro env vars.
#
# Copy to `.env.local` and fill in. The CROW_* pair is what production runs on;
# everything under "Payload trial" only exists on the `payload-trial` branch.

# --- Crow CMS (production content source) ---
NEXT_PUBLIC_CROW_CMS=
CROW_CMS_SECRET_KEY=
NEXT_PUBLIC_IMG_BASE=

# --- Payload trial ---------------------------------------------------------
# See ../axis/docs/crow-payload-trial.md. Nothing here is wired into the site;
# it powers the embedded admin at /admin only.

# Any random string. Signs Payload's auth cookies — changing it logs everyone out.
PAYLOAD_SECRET=

# Postgres connection string. Neon in the trial; pooled endpoint is fine.
# Without it the app builds, but /admin fails on first request.
DATABASE_URL=

# S3 for uploads. Leave S3_BUCKET empty to fall back to local disk (`media/`),
# which is how the branch runs before credentials exist.
# Must be a fresh trial bucket — never Crow's.
#
# The bucket needs an s3:GetObject policy on `<S3_PREFIX>/*`: file URLs point
# straight at it, and Payload's own serving route is disabled on purpose.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Key prefix inside the bucket.
S3_PREFIX=alikro

# Set to `payload` to make the site read from the embedded Payload instance via
# the Local API instead of Crow. Unset = Crow, exactly as production runs.
CONTENT_SOURCE=

# Staging copy of Crow's alikro/originals/, read by the migration script. Kept
# separate from the bucket Payload manages so "migrated vs staged" stays diffable.
CROW_STAGING_DIR=

# Optional CDN in front of the bucket. Unset in the trial: reads go straight to
# the bucket. CloudFront is deferred to a MIGRATE verdict.
NEXT_PUBLIC_PAYLOAD_ASSETS_DOMAIN=
